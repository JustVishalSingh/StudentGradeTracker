<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="1050.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentgrade.controller.StudentDashboardController"
            stylesheets="@../css/style.css">
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <Label text="🎓 Student Academic Performance Management System" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="user-label"/>
            <Button text="Logout" styleClass="btn-logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="2">
            <Label text="STUDENT PANEL" styleClass="sidebar-title"/>
            <Button fx:id="btnProfile"   text="👤  My Profile"      styleClass="nav-btn" maxWidth="Infinity" onAction="#showProfile"/>
            <Button fx:id="btnGrades"    text="📝  My Grades"       styleClass="nav-btn" maxWidth="Infinity" onAction="#showGrades"/>
            <Button fx:id="btnAnalytics" text="📈  My Performance"  styleClass="nav-btn" maxWidth="Infinity" onAction="#showAnalytics"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc;"/>
    </center>
</BorderPane>
